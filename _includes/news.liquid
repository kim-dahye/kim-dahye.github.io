{% assign news = site.news | where_exp: 'item', 'item.visible != false' | sort: 'date' | reverse %}
{% assign news_size = news | size %}
{% assign visible_count = site.announcements.visible_count | default: 5 %}
{% assign scroll_news = false %}
{% if include.limit and site.announcements.scrollable and news_size > visible_count %}
  {% assign scroll_news = true %}
{% endif %}
{% assign news_limit = news_size %}
{% if include.limit and site.announcements.limit and site.announcements.scrollable != true %}
  {% assign news_limit = site.announcements.limit %}
{% endif %}
<div class="news">
  {% if news_size > 0 %}
    <div
      class="news-feed{% if scroll_news %} news-feed-scrollable{% endif %}"
      {% if scroll_news %}
        data-news-visible="{{ visible_count }}" tabindex="0" role="region" aria-label="Latest news. Scroll for older updates."
      {% endif %}
    >
      <ol class="news-list">
        {% for item in news limit: news_limit %}
          <li class="news-item">
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %d, %Y' }}</time>
            <div class="news-content">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
    {% if scroll_news %}
      <p class="news-scroll-hint">Scroll for earlier updates <span aria-hidden="true">↓</span></p>
      <script defer src="{{ '/assets/js/news.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}
  {% else %}
    <p>No news so far.</p>
  {% endif %}
</div>
