---
layout: default
---
<div class="academic-home">
  <section class="profile-hero" aria-labelledby="profile-name">
    <div class="profile-intro">
      <p class="eyebrow">Computer vision &amp; machine learning</p>
      <h1 id="profile-name">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="profile-subtitle">{{ page.subtitle }}</p>
      <div class="profile-bio">{{ content }}</div>
      <nav class="profile-links" aria-label="Contact and academic profiles">
        <a class="profile-link-primary" href="{{ '/assets/pdf/CV.pdf' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
        <a href="mailto:{{ site.email }}">Email</a>
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.github_username }}">GitHub</a>
        {% if site.linkedin_username -%}
          <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}/">LinkedIn</a>
        {%- endif %}
      </nav>
    </div>
    {% if page.profile.image %}
      <div class="profile-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid loading="eager" path=profile_image_path alt="Dahye Kim" class="portrait-image" cache_bust=true %}
        <p>
          Boston University<br>
          <span>Department of Computer Science</span>
        </p>
      </div>
    {% endif %}
  </section>

  <ul class="research-interests" aria-label="Research interests">
    {% for interest in site.data.profile.interests %}
      <li>{{ interest }}</li>
    {% endfor %}
  </ul>

  {% if page.news and site.announcements.enabled %}
    <section class="home-section news-section" aria-labelledby="news-heading">
      <div class="section-heading">
        <h2 id="news-heading">News</h2>
        <a href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section" aria-labelledby="research-heading">
      <div class="section-heading">
        <h2 id="research-heading">Publications &amp; preprints</h2>
        <a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <section class="home-section" aria-labelledby="experience-heading">
    <div class="section-heading">
      <h2 id="experience-heading">Research experience</h2>
      <a href="{{ '/assets/pdf/CV.pdf' | relative_url }}">Full CV <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="experience-list">
      {% for entry in site.data.profile.experience %}
        <li>
          <p class="experience-dates">{{ entry.dates }}</p>
          <div>
            <h3>{{ entry.organization }}</h3>
            <p class="experience-role">{{ entry.role }}</p>
            <p class="experience-detail">{{ entry.detail }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </section>

  <div class="academic-details">
    <section aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ul class="detail-list">
        {% for entry in site.data.profile.education %}
          <li>
            <h3>{{ entry.school }}</h3>
            <p>{{ entry.degree }}</p>
            <p class="detail-meta">{{ entry.dates }}</p>
          </li>
        {% endfor %}
      </ul>
    </section>
    <section aria-labelledby="service-heading">
      <h2 id="service-heading">Professional service</h2>
      <ul class="detail-list">
        {% for entry in site.data.profile.service %}
          <li>
            <h3>{{ entry.title }}</h3>
            <p>
              {% if entry.url -%}
                <a href="{{ entry.url }}">{{ entry.detail }}</a>
              {%- else -%}
                {{- entry.detail -}}
              {%- endif %}
            </p>
          </li>
        {% endfor %}
      </ul>
    </section>
    <section aria-labelledby="recognition-heading">
      <h2 id="recognition-heading">Selected honors</h2>
      <ul class="detail-list">
        {% for entry in site.data.profile.recognition %}
          <li>
            <h3>{{ entry.title }}</h3>
            <p>{{ entry.detail }}</p>
          </li>
        {% endfor %}
      </ul>
    </section>
    <section aria-labelledby="teaching-heading">
      <h2 id="teaching-heading">Teaching</h2>
      <ul class="detail-list">
        {% for entry in site.data.profile.teaching %}
          <li>
            <h3>{{ entry.course }}</h3>
            <p>{{ entry.detail }}</p>
          </li>
        {% endfor %}
      </ul>
    </section>
  </div>

  <div class="contact-closing">
    <p>Always happy to connect about research and collaborations.</p>
    <a href="mailto:{{ site.email }}">
      {{- site.email }}
      <span aria-hidden="true">↗</span></a
    >
  </div>
</div>
